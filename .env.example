# Database
DATABASE_URL=postgresql://user:password@localhost:5432/arbitrage_iq

# Authentication
BETTER_AUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# OpenAI API
OPENAI_API_KEY=sk-your-api-key-here

# Encryption
ENCRYPTION_KEY=your-encryption-key-here

# Node Environment
NODE_ENV=development

# reCAPTCHA v3 (get keys from https://www.google.com/recaptcha/admin)
# NEXT_PUBLIC_ prefix means the site key is safe to expose on client
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key_here
